    "import sklearn\n",
    "with open('displays.tsv', 'w', encoding='utf-8') as file:\n",
    "    for display_class, display_path in sklearn.utils.discovery.all_displays():\n",
    "        file.writelines('display_class\\tdisplay_path\\n')\n",
    "        print(f'''{display_class}\\t{str(display_path).split(\"'\")[1]}''')"
